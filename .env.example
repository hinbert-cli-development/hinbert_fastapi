# Runtime mode; seed_data.py refuses to run outside development.
ENVIRONMENT=development
# Async database URL; use PostgreSQL in production and SQLite for local smoke tests.
DATABASE_URL=sqlite+aiosqlite:///./test.db
# Redis URL used by distributed rate limiting and background jobs.
REDIS_URL=redis://localhost:6379/0
# Signing secret; replace with a long secret-manager value before deployment.
SECRET_KEY=local-development-secret-change-me
# JWT signing algorithm; HS256 is supported by the default implementation.
ALGORITHM=HS256
# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh-token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30
# SMTP server hostname.
SMTP_HOST=localhost
# SMTP server port.
SMTP_PORT=587
# SMTP username, if authentication is required.
SMTP_USER=
# SMTP password; leave blank for a local unauthenticated mail server.
SMTP_PASSWORD=
# From address used for verification and reset messages.
EMAIL_FROM=no-reply@example.com
# Google OAuth client identifier.
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Facebook OAuth client identifier.
FACEBOOK_CLIENT_ID=
# Facebook OAuth client secret.
FACEBOOK_CLIENT_SECRET=
# Requests permitted per minute per client address.
RATE_LIMIT_PER_MINUTE=100/minute
# Optional display name in generated OpenAPI metadata.
APP_NAME=Hinbert FastAPI
# Optional debug flag for local tooling; keep false in production.
DEBUG=false
# JSON list of trusted browser origins.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]